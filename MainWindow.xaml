<?xml version="1.0" encoding="utf-8"?>
<!-- One page with every option on it: the window sizes itself to fit all of it (MainWindow.xaml.cs),
     and only scrolls on a screen too small to show it whole. -->
<Window
    x:Class="BF1942Options.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Battlefield 1942 Options">
    <Grid x:Name="Page" Background="{StaticResource PageBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SideColumn" Width="230" />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <!-- Our own title bar (the window draws into it), so the icon and title line up on one centre line.
             The minimize/close buttons are drawn by Windows on top of its right end. -->
        <Grid x:Name="AppTitleBar" Grid.ColumnSpan="2" Background="{StaticResource ArtBlackBrush}" Padding="12,0,0,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>
            <Image x:Name="TitleIcon" Width="16" Height="16" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Battlefield 1942 Options" Style="{StaticResource CaptionTextBlockStyle}"
                       Foreground="{StaticResource KhakiBrush}" VerticalAlignment="Center" />
        </Grid>

        <!-- Switches and icon buttons carry AutomationProperties.Name, so screen readers say what they are -->
        <!-- Left side: the installer's box art (or the game's name when the build has none), then buttons to
             play, join the server and the Discord (when the build has them), open the game folder and the guide,
             and the game folder. The art takes the space that is left, so in a short window it shrinks and the
             buttons always stay in view. -->
        <Grid x:Name="Sidebar" Grid.Row="1" Background="{StaticResource ArtBlackBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Image x:Name="Art" Stretch="Uniform" VerticalAlignment="Top" />
            <StackPanel x:Name="ArtText" Visibility="Collapsed" Padding="18,24,18,8" Spacing="0">
                <TextBlock Text="BATTLEFIELD" FontFamily="{StaticResource StencilFont}" FontWeight="Bold" FontSize="30"
                           Foreground="{StaticResource KhakiBrush}" />
                <TextBlock Text="1942" FontFamily="{StaticResource StencilFont}" FontWeight="Bold" FontSize="30" CharacterSpacing="300"
                           Foreground="{StaticResource BrassBrush}" />
            </StackPanel>

            <StackPanel x:Name="SideButtons" Grid.Row="1" Padding="14,0,14,0" Spacing="8">
                <Rectangle Height="1" Fill="{StaticResource CardStrokeBrush}" Margin="0,4,0,6" />
                <Button x:Name="PlayButton" AutomationProperties.Name="Play" Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch" Padding="12,9" Click="Play_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE768;" FontSize="14" />
                        <TextBlock Text="PLAY" FontFamily="{StaticResource StencilFont}" FontWeight="Bold" CharacterSpacing="200" />
                    </StackPanel>
                </Button>
                <Button x:Name="JoinButton" HorizontalAlignment="Stretch" Click="Join_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE774;" FontSize="14" />
                        <TextBlock x:Name="JoinText" Text="Join the server" />
                    </StackPanel>
                </Button>
                <Button x:Name="DiscordButton" AutomationProperties.Name="Join our Discord" HorizontalAlignment="Stretch" Click="Discord_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE8BD;" FontSize="14" />
                        <TextBlock Text="Join our Discord" />
                    </StackPanel>
                </Button>
                <Button HorizontalAlignment="Stretch" AutomationProperties.Name="Open game folder" Click="OpenFolder_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE838;" FontSize="14" />
                        <TextBlock Text="Open game folder" />
                    </StackPanel>
                </Button>
                <Button x:Name="Guide" AutomationProperties.Name="Troubleshooting guide" HorizontalAlignment="Stretch" Click="Guide_Click">
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <FontIcon Glyph="&#xE897;" FontSize="14" />
                        <TextBlock Text="Troubleshooting guide" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel x:Name="SideFolder" Grid.Row="2" Padding="14,12,14,18" Spacing="2">
                <TextBlock Text="GAME FOLDER" Style="{StaticResource CardTitle}" FontSize="11" Margin="0" />
                <TextBlock x:Name="GameFolder" Style="{StaticResource Hint}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Grid>

    <Grid x:Name="Root" Grid.Row="1" Grid.Column="1" Padding="24,14,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="2" Margin="0,0,0,14">
            <TextBlock Text="BATTLEFIELD 1942 OPTIONS" FontFamily="{StaticResource StencilFont}" FontWeight="Bold" FontSize="28"
                       CharacterSpacing="80" Foreground="{StaticResource KhakiBrush}" />
            <TextBlock Foreground="{StaticResource HintBrush}" TextWrapping="Wrap"
                       Text="Turn the fixes and extras on or off. Nothing changes until you click Apply. Close the game first." />
        </StackPanel>

        <!-- Two columns that end on the same line. The cards are shared out so both columns hold about the same
             amount, and the last card in each column stretches the little that is left, with its button at the
             bottom. The columns follow the window's width; in a narrow window the right column moves under the
             left one (MainWindow.xaml.cs), and only this part scrolls, so the title, Apply and Close stay in view. -->
        <ScrollViewer x:Name="Scroller" Grid.Row="1" HorizontalScrollMode="Disabled" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <Grid x:Name="Columns" ColumnSpacing="16" RowSpacing="0" VerticalAlignment="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Left: graphics fix, game fixes, CD key -->
                <Grid x:Name="LeftColumn" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border x:Name="GraphicsCard" Style="{StaticResource Card}">
                        <StackPanel Spacing="4">
                            <TextBlock Text="GRAPHICS FIX" Style="{StaticResource CardTitle}" />
                            <RadioButton x:Name="Dxvk" GroupName="Renderer" Checked="Changed">
                                <StackPanel>
                                    <TextBlock x:Name="DxvkTitle" Text="DXVK" Style="{StaticResource Setting}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="By doitsujin. Best for graphics cards with full Vulkan 1.3 support, which is most cards from 2016 or later." />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="DgVoodoo" GroupName="Renderer" Checked="Changed">
                                <StackPanel>
                                    <TextBlock x:Name="DgVoodooTitle" Text="dgVoodoo2" Style="{StaticResource Setting}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="By Dege. For older cards and AMD Radeon RX 400/500, or if DXVK gives you a black screen." />
                                </StackPanel>
                            </RadioButton>
                            <Grid ColumnSpacing="12" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="RendererNow" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <Button x:Name="CheckGraphics" Grid.Column="1" Content="Check my graphics card" Click="CheckGraphics_Click" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="GAME FIXES" Style="{StaticResource CardTitle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock x:Name="BF42ppTitle" Text="BF42++" Style="{StaticResource Setting}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="By Casqade. Bug fixes and improvements. Its settings are in bf42++.ini." />
                                </StackPanel>
                                <ToggleSwitch x:Name="BF42pp" AutomationProperties.Name="BF42++" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="3D positional audio" Style="{StaticResource Setting}" />
                                    <TextBlock Style="{StaticResource Hint}" Text="DSOAL + OpenAL Soft by kcat. Surround sound for headphones and speakers." />
                                </StackPanel>
                                <ToggleSwitch x:Name="Audio" AutomationProperties.Name="3D positional audio" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- CD key: only offered when none is registered -->
                    <Border x:Name="SerialCard" Grid.Row="2" Style="{StaticResource Card}">
                        <Grid RowSpacing="6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="4">
                                <TextBlock Text="CD KEY" Style="{StaticResource CardTitle}" />
                                <TextBlock x:Name="SerialNow" Style="{StaticResource Setting}" />
                                <TextBlock x:Name="SerialHint" Style="{StaticResource Hint}" />
                            </StackPanel>
                            <Button x:Name="GenerateSerial" Grid.Row="1" Content="Generate a CD key" Click="GenerateSerial_Click"
                                    HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="0,4,0,0" />
                        </Grid>
                    </Border>
                </Grid>

                <!-- Right: extras, display -->
                <Grid x:Name="RightColumn" Grid.Column="1" RowSpacing="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource Card}">
                        <StackPanel Spacing="10">
                            <TextBlock Text="EXTRAS" Style="{StaticResource CardTitle}" />
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Battle of Britain - disable siren" Style="{StaticResource Setting}" />
                                    <TextBlock x:Name="SirenHint" Style="{StaticResource Hint}" Text="By Nicole @ MoonGamers. Removes the air raid siren from Battle of Britain." />
                                </StackPanel>
                                <ToggleSwitch x:Name="NoSiren" AutomationProperties.Name="Battle of Britain - disable siren" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                            </Grid>
                            <Grid ColumnSpacing="16">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Compatibility Profile" Style="{StaticResource Setting}" />
                                    <TextBlock x:Name="CompatHint" Style="{StaticResource Hint}" Text="By PCGamingWiki. Windows compatibility fixes. Only turn this on if the game crashes without it." />
                                </StackPanel>
                                <ToggleSwitch x:Name="Compat" AutomationProperties.Name="Compatibility Profile" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource Card}">
                        <Grid RowSpacing="10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <StackPanel Spacing="10">
                                <TextBlock Text="DISPLAY" Style="{StaticResource CardTitle}" />
                                <ComboBox x:Name="FontSize" Header="Font size" HorizontalAlignment="Stretch" SelectionChanged="FontSize_SelectionChanged" />
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Higher resolution UI" Style="{StaticResource Setting}" />
                                        <TextBlock x:Name="HiResHint" Style="{StaticResource Hint}" Text="Sharper menus and HUD." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="HiResUI" AutomationProperties.Name="Higher resolution UI" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Borderless1942" Style="{StaticResource Setting}" />
                                        <TextBlock x:Name="BorderlessHint" Style="{StaticResource Hint}" Text="By Turnerj, LANCommander and Nicole. A borderless window, so Alt-Tab doesn't minimize the game. Adds a desktop shortcut." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="Borderless" AutomationProperties.Name="Borderless1942" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                                </Grid>
                                <Grid ColumnSpacing="16">
                                    <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Skip the intro videos" Style="{StaticResource Setting}" />
                                        <TextBlock x:Name="SkipHint" Style="{StaticResource Hint}" Text="For the Battlefield 1942 desktop shortcuts and the Play button." />
                                    </StackPanel>
                                    <ToggleSwitch x:Name="SkipIntro" AutomationProperties.Name="Skip the intro videos" Grid.Column="1" Style="{StaticResource Switch}" Toggled="Changed" />
                                </Grid>
                            </StackPanel>
                            <Grid Grid.Row="1" ColumnSpacing="12" VerticalAlignment="Bottom" Margin="0,4,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="ScreenNow" Style="{StaticResource Hint}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="Use my screen's resolution" Click="Resolution_Click" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>


        <Grid Grid.Row="3" ColumnSpacing="8" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="FooterNote" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,16,0"
                       Text="DataField42, Battlefield Rich Presence and PunkBuster are separate programs: run the installer again (Custom) to add them, or remove them in Settings &gt; Apps." />
            <!-- Messages take the note's place next to Apply and Close, so they don't push the cards up -->
            <InfoBar x:Name="Status" IsOpen="False" Visibility="Collapsed" Margin="0,0,16,0" VerticalAlignment="Center" Closed="Status_Closed" />
            <Button x:Name="ApplyButton" Grid.Column="1" Content="Apply" Style="{StaticResource AccentButtonStyle}" MinWidth="110" Click="Apply_Click" />
            <Button Grid.Column="2" Content="Close" MinWidth="110" Click="Close_Click" />
        </Grid>
    </Grid>
    </Grid>
</Window>
